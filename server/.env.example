POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=toktickit
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/toktickit?schema=public"

# Session secret for express-session. Generate a random value locally, e.g.
# `openssl rand -hex 32` — NEVER commit a real secret.
SESSION_SECRET=change_me_in_.env